+// Patched locally (see https://github.com/Thinkmill/keystatic/pull/1546) to fix
+// "Bad data" 400s on save: relative asset references inside content fields get
+// concatenated into wire-format paths like
+// `src/content/blog/{slug}/content/../../assets/blog/x.png`, which the update
+// API rejects outright because it disallows any `..` path segment. This
+// resolves `..`/`.` segments client-side before the path is sent.
+function normalizePosixPath(path) {
+  const isAbsolute = path.startsWith('/');
+  const segments = path.split('/');
+  const result = [];
+  for (const seg of segments) {
+    if (seg === '' || seg === '.') continue;
+    if (seg === '..') {
+      if (result.length > 0 && result[result.length - 1] !== '..') {
+        result.pop();
+      } else if (!isAbsolute) {
+        result.push('..');
+      }
+      continue;
+    }
+    result.push(seg);
+  }
+  return (isAbsolute ? '/' : '') + result.join('/');
+}
